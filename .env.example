# Copy this file to .env and replace every placeholder.
# Never commit .env. The API refuses to start while placeholders are still in place.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Include the database name, for example /lamton.
# The API does not fall back to a file or an in-memory database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/lamton

# Optional. Use this only when the database name is not already in MONGODB_URI.
MONGODB_DB_NAME=

# At least 32 random characters. Generate one with:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Browser origin of the Vite app. No path, no trailing slash.
WEB_ORIGIN=http://localhost:5173

# false for local http. Production defaults to a Secure cookie when this is unset.
COOKIE_SECURE=false

# Used only by `npm run provision:admin`. Leave blank until you run that command.
# Public signup cannot create an admin, and there is no default password.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
