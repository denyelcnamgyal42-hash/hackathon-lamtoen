{
  "name": "@lamton/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @lamton/shared",
    "dev": "vite",
    "prebuild": "npm run build -w @lamton/shared",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "pretypecheck": "npm run build -w @lamton/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @lamton/shared",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lamton/shared": "*",
    "@tanstack/react-query": "^5.90.7",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
