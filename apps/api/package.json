{
  "name": "@lamton/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @lamton/shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build -w @lamton/shared",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @lamton/shared",
    "test": "vitest run",
    "start": "node dist/index.js",
    "provision:admin": "tsx src/scripts/provision-admin.ts"
  },
  "dependencies": {
    "@lamton/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
